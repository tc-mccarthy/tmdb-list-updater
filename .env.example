# Purpose: Runtime settings consumed by Docker Compose; copy to .env.
# Application API Read Access Token from https://www.themoviedb.org/settings/api.
# Used to generate the clickable user approval link and exchange the request token.
TMDB_APPLICATION_TOKEN=
# Optional existing user-token override; normally leave empty to use cached approval.
TMDB_ACCESS_TOKEN=
# The browser and Docker must run on the same host for these defaults.
AUTH_PORT=8787
TMDB_CALLBACK_URL=http://localhost:8787/auth/callback
AUTH_TIMEOUT_SECONDS=600
TMDB_REAUTHORIZE=false
# Existing list owned by the authenticated user.
TMDB_LIST_URL=https://www.themoviedb.org/list/12345
# Place the file in ./storage; this path is inside the container.
CSV_PATH=/usr/app/storage/movies.csv
UPDATE_MODE=append
TMDB_MEDIA_TYPE=movie
DRY_RUN=false
