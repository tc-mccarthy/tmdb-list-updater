# Purpose: Runtime settings consumed by Docker Compose; copy to .env.
# User-authorized v4 token, not the application read token.
TMDB_ACCESS_TOKEN=
# Existing list owned by the authenticated user.
TMDB_LIST_URL=https://www.themoviedb.org/list/12345
# Place the file in ./storage; this path is inside the container.
CSV_PATH=/usr/app/storage/movies.csv
UPDATE_MODE=append
TMDB_MEDIA_TYPE=movie
DRY_RUN=false
